{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "node",
      "vitest/globals",
      "@cloudflare/workers-types",
      "@cloudflare/vitest-pool-workers/types"
    ]
  },
  "include": [
    "src/**/*.ts",
    "infra/**/*.ts",
    "test/**/*.ts",
    "alchemy.run.ts",
    "drizzle.config.ts",
    "vitest.config.ts",
    "playwright.config.ts"
  ]
}
