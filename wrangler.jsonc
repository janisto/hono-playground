{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hono-playground",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-22",
  "workers_dev": true,
  "preview_urls": false,
  "send_metrics": false,
  "dependencies_instrumentation": {
    "enabled": true
  },
  "upload_source_maps": true,
  "vars": {
    "ENVIRONMENT": "development",
    "DEPLOYMENT_PROFILE": "workers-dev-demo",
    "LOG_LEVEL": "info",
    "MAX_REQUEST_SIZE_BYTES": "1000000",
    "ACCESS_TEAM_DOMAIN": "https://replace-me.cloudflareaccess.com",
    "ACCESS_AUD": "replace-before-phase-8",
    "MANAGED_OAUTH_ENABLED": "false",
    "RATE_LIMIT_MODE": "workers-binding"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hono-playground",
      "migrations_dir": "./migrations",
      "remote": false
    }
  ],
  "assets": {
    "directory": "./public",
    "run_worker_first": false,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    }
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "ratelimits": [
    {
      "name": "PUBLIC_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 300,
        "period": 60
      }
    },
    {
      "name": "PROFILE_READ_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 120,
        "period": 60
      }
    },
    {
      "name": "PROFILE_WRITE_RATE_LIMITER",
      "namespace_id": "1003",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ]
}
