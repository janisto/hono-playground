{
  "name": "hono-playground",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.15.1+sha512.81350b07e53c9538a02f1f2303b4290fa2d7be04e56e2a970c4cc4b417dc761de196edabd49d55c7dc9580db81007c44143e4e3d7e462b3000d23c255122d065",
  "engines": {
    "node": "24",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "dev": "WRANGLER_WRITE_LOGS=false wrangler dev --local",
    "types": "WRANGLER_WRITE_LOGS=false wrangler types worker-configuration.d.ts --env-file .dev.vars.example",
    "types:check": "WRANGLER_WRITE_LOGS=false wrangler types --check --env-file .dev.vars.example",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.tools.json",
    "test": "WRANGLER_WRITE_LOGS=false vitest run",
    "test:unit": "WRANGLER_WRITE_LOGS=false vitest run test/unit",
    "test:integration": "WRANGLER_WRITE_LOGS=false vitest run test/integration",
    "test:d1": "WRANGLER_WRITE_LOGS=false vitest run test/d1",
    "test:contract": "WRANGLER_WRITE_LOGS=false vitest run test/contract",
    "coverage": "WRANGLER_WRITE_LOGS=false vitest run --coverage",
    "docs:assets": "node scripts/build-doc-assets.mjs",
    "docs:assets:check": "node scripts/build-doc-assets.mjs --check",
    "openapi:generate": "tsx scripts/generate-openapi-client.ts",
    "openapi:check": "tsx scripts/generate-openapi-client.ts --check",
    "licenses:check": "node scripts/check-licenses.mjs",
    "audit:prod": "pnpm audit --prod --audit-level high",
    "audit:all": "pnpm audit --audit-level high",
    "config:check": "node scripts/check-wrangler-config.mjs",
    "production:check": "node scripts/check-production-config.mjs",
    "deploy:dry-run": "WRANGLER_WRITE_LOGS=false wrangler deploy --dry-run --outdir dist",
    "deploy:production": "pnpm qa && pnpm production:check && WRANGLER_WRITE_LOGS=false wrangler deploy --strict",
    "db:migrations:list:local": "WRANGLER_WRITE_LOGS=false wrangler d1 migrations list hono-playground --local",
    "db:migrations:apply:local": "WRANGLER_WRITE_LOGS=false wrangler d1 migrations apply hono-playground --local",
    "db:migrations:list:remote": "WRANGLER_WRITE_LOGS=false wrangler d1 migrations list hono-playground --remote",
    "db:migrations:apply:remote": "WRANGLER_WRITE_LOGS=false wrangler d1 migrations apply hono-playground --remote",
    "tail": "WRANGLER_WRITE_LOGS=false wrangler tail --format json",
    "test:e2e": "playwright test",
    "qa": "pnpm docs:assets:check && pnpm openapi:check && pnpm licenses:check && pnpm audit:prod && pnpm check && pnpm typecheck && pnpm types:check && pnpm coverage && pnpm config:check && pnpm deploy:dry-run"
  },
  "dependencies": {
    "@hono/zod-openapi": "1.5.1",
    "hono": "4.12.31",
    "jose": "6.2.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.18.7",
    "@cloudflare/workers-types": "5.20260722.1",
    "@biomejs/biome": "2.5.5",
    "@playwright/test": "1.61.1",
    "@types/node": "26.1.1",
    "@vitest/coverage-istanbul": "4.1.10",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "fast-check": "4.9.0",
    "jsonc-parser": "3.3.1",
    "openapi-fetch": "0.17.0",
    "openapi-typescript": "7.13.0",
    "swagger-ui-dist": "5.32.11",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "wrangler": "4.113.0"
  }
}
