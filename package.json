{
  "name": "hono-playground",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": "26",
    "pnpm": ">=12 <13"
  },
  "scripts": {
    "dev": "alchemy dev",
    "infra:plan": "pnpm db:check && alchemy plan",
    "infra:deploy": "pnpm qa && alchemy deploy",
    "infra:logs": "alchemy logs",
    "infra:tail": "alchemy tail",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.tools.json",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:d1": "vitest run test/d1",
    "coverage": "vitest run --coverage",
    "audit": "pnpm audit --audit-level high",
    "db:preview": "drizzle-kit generate --explain",
    "db:generate": "drizzle-kit generate --name",
    "db:check": "drizzle-kit check && drizzle_status=\"$(drizzle-kit generate --explain --output=json)\" && printf '%s\\n' \"$drizzle_status\" && test \"$drizzle_status\" = '{\"status\":\"no_changes\",\"dialect\":\"sqlite\"}'",
    "test:e2e": "playwright test",
    "qa": "pnpm workflow:check && pnpm check && pnpm typecheck && pnpm db:check && pnpm coverage && pnpm run audit",
    "workflow:check": "actionlint && uvx --from zizmor==1.32.0 zizmor --offline --persona=pedantic ."
  },
  "dependencies": {
    "@hono/swagger-ui": "0.6.2",
    "@hono/zod-openapi": "1.6.3",
    "drizzle-orm": "1.0.0-rc.5",
    "hono": "4.13.16",
    "jose": "6.2.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@cloudflare/workers-types": "5.20261103.1",
    "@effect/platform-node": "4.1.2",
    "@effect/platform-node-shared": "4.1.2",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@vitest/coverage-istanbul": "5.1.0",
    "alchemy": "2.0.0-beta.85",
    "drizzle-kit": "1.0.0-rc.5",
    "effect": "4.1.2",
    "fast-check": "4.10.2",
    "miniflare": "5.20261103.0-beta",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.1.0",
    "redis": "6.3.1",
    "@alchemy.run/cloudflare": "2.0.0-beta.85",
    "@cloudflare/vitest-plugin": "1.5.1"
  }
}
