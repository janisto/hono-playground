{
  "name": "hono-playground",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621",
  "engines": {
    "node": "24",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "dev": "alchemy dev",
    "infra:plan": "pnpm db:check && alchemy plan",
    "infra:deploy": "pnpm qa && alchemy deploy",
    "infra:logs": "alchemy logs",
    "infra:tail": "alchemy tail",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.tools.json",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:d1": "vitest run test/d1",
    "coverage": "vitest run --coverage",
    "audit": "pnpm audit --audit-level high",
    "db:preview": "drizzle-kit generate --explain",
    "db:generate": "drizzle-kit generate --name",
    "db:check": "drizzle-kit check && drizzle_status=\"$(drizzle-kit generate --explain --output=json)\" && printf '%s\\n' \"$drizzle_status\" && test \"$drizzle_status\" = '{\"status\":\"no_changes\",\"dialect\":\"sqlite\"}'",
    "test:e2e": "playwright test",
    "qa": "pnpm check && pnpm typecheck && pnpm db:check && pnpm coverage"
  },
  "dependencies": {
    "@hono/swagger-ui": "0.6.1",
    "@hono/zod-openapi": "1.6.1",
    "drizzle-orm": "1.0.0-rc.4",
    "hono": "4.13.3",
    "jose": "6.2.9",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@cloudflare/workers-types": "5.20260821.1",
    "@effect/platform-node": "4.0.0-beta.107",
    "@effect/platform-node-shared": "4.0.0-beta.107",
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3",
    "@vitest/coverage-istanbul": "4.1.11",
    "alchemy": "2.0.0-beta.65",
    "drizzle-kit": "1.0.0-rc.4",
    "effect": "4.0.0-beta.107",
    "fast-check": "4.9.0",
    "ioredis": "5.11.1",
    "miniflare": "5.20260820.0-alpha",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
